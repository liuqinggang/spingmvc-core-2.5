<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the Cloud Agent environment.

  The project's pom.xml declares the Maven Central repository over plain HTTP
  (http://repo.maven.apache.org/maven2). Maven Central no longer serves
  artifacts over HTTP (requests are redirected/blocked), so this mirror
  transparently routes every repository request to the HTTPS endpoint.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>central-https</id>
      <name>Maven Central over HTTPS</name>
      <url>https://repo1.maven.org/maven2</url>
      <mirrorOf>external:*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
